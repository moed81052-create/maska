@echo off
chcp 65001 > nul
title رفع مشروع مسكة إلى GitHub
color 0A
echo ======================================================================
echo  🌸 جاري رفع كود وتعديلات مشروع مسكة إلى مستودع GitHub...
echo ======================================================================
echo.

cd /d "%~dp0"

echo [+] التحقق من حالة المستودع:
git status -s

echo.
echo [+] جاري إرسال التحديثات (Pushing to origin main)...
git push -u origin main

echo.
if %ERRORLEVEL% equ 0 (
    echo ======================================================================
    echo  ✅ تم رفع المشروع بنجاح إلى GitHub! مبروك 🌸
    echo ======================================================================
) else (
    echo ======================================================================
    echo  ❌ حدث خطأ أو يتطلب تسجيل الدخول إلى حسابك في GitHub.
    echo ======================================================================
)

echo.
pause

