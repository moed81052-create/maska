# =============================================================================
# 🌸 نموذج متغيرات البيئة لمشروع مسكة | MASKA ENVIRONMENT TEMPLATE (.env.example)
# انسخ هذا الملف إلى .env وقم بتعديل إعدادات الخادم والربط بقاعدة البيانات
# =============================================================================

# 1. إعدادات خادم الويب (Server Settings)
PORT=3000
NODE_ENV=development
APP_NAME="مَـسْـكَة أتيليه | MASKA ATELIER"
APP_URL=http://localhost:3000

# 2. إعدادات والربط بقاعدة البيانات (Database Connection & Driver)
# نوع قاعدة البيانات (mysql / sqlite)
DB_CONNECTION=mysql
DB_CLIENT=mysql2
DB_DIALECT=mysql

# رابط الاتصال الموحد المباشر بخادم MySQL
DATABASE_URL=mysql://root:1234@127.0.0.1:3306/maska_db

# إعدادات الاتصال بخادم MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maska_db
DB_USERNAME=root
DB_PASSWORD=1234
DB_LOGGING=false

# مسار ملف قاعدة بيانات SQLite المحلية (احتياطي)
DB_PATH=database/maska.db
DB_FILE=database/maska.db

# 3. مفاتيح التشفير وجلسات الأمان (Security, Auth & Secrets)
JWT_SECRET=your_secret_key_here
SESSION_SECRET=your_session_secret_here

# 4. أرقام هواتف التواصل وغرفة العمليات (Operations & Support Contacts)
ADMIN_PHONE=0911111111
OPERATIONS_PHONE=0911111111
STORE_EMAIL=contact@maska.ly

# 5. إعدادات التوصيل والخرائط اللوجستية (Delivery & GPS Coordinates)
DEFAULT_CITY=طرابلس
DELIVERY_BASE_FEE=10
DEFAULT_MAP_LAT=32.8872
DEFAULT_MAP_LNG=13.1913

# 6. سياسة مشاركة الموارد والواجهات (CORS & API Security)
CORS_ORIGIN=*
